# Copie este arquivo para ".env" e preencha com os seus dados reais.
# O arquivo ".env" NUNCA deve ser enviado para o GitHub (já está no .gitignore).

# Porta em que o servidor Express vai rodar
PORT=3000

# Dados de conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_sua_senha_aqui
DB_NAME=rise

# Chave secreta usada para assinar os tokens JWT.
# Use uma frase longa e aleatória, nunca uma palavra simples.
JWT_SECRET=troque_isto_por_uma_frase_secreta_bem_longa_e_aleatoria

# Tempo de validade do token (ex: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d
